# Copy to .env.local and fill in. Everything here is public (NEXT_PUBLIC_*) except the webhook.

# Live site URL, used for canonical links, sitemap and structured data.
# Optional on Vercel: until it's set, the project's production domain is used.
NEXT_PUBLIC_SITE_URL=https://www.socialstays.in

# WhatsApp number that receives enquiries: country code + number, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Click-to-call number
NEXT_PUBLIC_PHONE_E164=+91XXXXXXXXXX
NEXT_PUBLIC_PHONE_DISPLAY=+91 XXXXX XXXXX
NEXT_PUBLIC_EMAIL=hello@socialstays.in

# Google Tag Manager container. GA4, Meta Pixel and Conversions API are configured inside GTM.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Where owner partnership leads are posted (Google Apps Script web app → Sheet + email, or the backend)
OWNER_LEADS_WEBHOOK_URL=
