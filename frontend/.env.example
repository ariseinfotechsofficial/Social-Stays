# Copy to .env.local and fill in. Contact details, tracking IDs and SEO now live in the admin panel (Settings).

# Backend API, also used for photo URLs. Must be reachable when the site builds.
NEXT_PUBLIC_API_URL=https://api.socialstays.in
# Optional: a private address the server should use for the API instead (e.g. http://127.0.0.1:4000 on a VPS)
API_URL=

# Same value as REVALIDATE_SECRET in the backend's .env; lets admin saves refresh the site
REVALIDATE_SECRET=

# Live site URL, used for canonical links, sitemap and structured data.
# Optional on Vercel: until it's set, the project's production domain is used.
NEXT_PUBLIC_SITE_URL=https://www.socialstays.in

# Optional: more hosts photos may come from, comma-separated (e.g. a CDN in front of the backend)
EXTRA_IMAGE_HOSTS=
