NODE_ENV=development
PORT=4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/Social_Stays?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-long-random-string

# This server's public URL (used to build image URLs)
PUBLIC_URL=http://localhost:4000
# Where uploaded files are written. On the VPS point this at a backed-up folder.
UPLOADS_DIR=./uploads

# Website (CORS, emails, revalidation). The admin is served by the website at /admin, so ADMIN_URL is the same origin.
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
REVALIDATE_SECRET=same-value-as-the-website

# Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Guest emails (optional; without these, emails are logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Social Stays <bookings@socialstays.in>"

# First Super Admin, created by npm run seed
SEED_ADMIN_EMAIL=admin@socialstays.in
SEED_ADMIN_PASSWORD=change-me
